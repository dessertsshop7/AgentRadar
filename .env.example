# 仅限本机开发的示例凭据；不要用于公开部署。
POSTGRES_DB=agentradar
POSTGRES_USER=agentradar
POSTGRES_PASSWORD=agentradar_dev_only
POSTGRES_PORT=15432

# 宿主机上运行 API / Alembic 使用此地址；Compose 会改用 db:5432。
DATABASE_URL=postgresql+psycopg://agentradar:agentradar_dev_only@127.0.0.1:15432/agentradar
DATABASE_TIMEOUT_SECONDS=3
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
LOG_LEVEL=INFO

# 浏览器可访问的地址；NEXT_PUBLIC_* 会在前端构建时写入客户端产物。
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
