# 仅限本机开发的示例凭据；不要用于公开部署。
POSTGRES_DB=agentradar
POSTGRES_USER=agentradar
POSTGRES_PASSWORD=agentradar_dev_only
POSTGRES_PORT=15432

# 宿主机上运行 API / Alembic 使用此地址；Compose 会改用 db:5432。
DATABASE_URL=postgresql+psycopg://agentradar:agentradar_dev_only@127.0.0.1:15432/agentradar
DATABASE_TIMEOUT_SECONDS=3
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
LOG_LEVEL=INFO

# P02：仅后端使用；令牌填入真实 .env，不要放到 NEXT_PUBLIC_*。
GITHUB_TOKEN=
SYNC_ENABLED=false
TREND_FORMULA_VERSION=p02-v1
TREND_WEIGHTS={"growth":0.5,"activity":0.25,"freshness":0.15,"quality":0.1}
SYNC_INTERVAL_HOURS=24
SYNC_MAX_RECORDS=1500
SYNC_README_LIMIT=30
SYNC_MCP_LIMIT=100

# 浏览器可访问的地址；NEXT_PUBLIC_* 会在前端构建时写入客户端产物。
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
